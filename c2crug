HEAP_FNS = {"malloc", "calloc", "realloc", "reallocarray", "strdup",
            "strndup", "aligned_alloc"}
HEAP_RELEASE = "free"
NON_RETAINING = {
    "strlen", "strnlen", "strcmp", "strncmp", "strchr",
    "strrchr", "strstr", "memcmp", "memchr", "memcpy",
    "memmove", "memset", "strcpy", "strncpy", "printf",
    "fprintf", "sprintf", "snprintf", "puts", "fputs",
    "fgets", "fgetc", "fputc", "fread", "fwrite",
    "fclose", "perror", "strtol", "atoi", "strtoul",
}
SKIP_WORDS = {"sizeof", "offsetof", "alignof", "_Alignof", "_Static_assert",
              "typeof", "__typeof__", "return", "if", "while", "for",
              "switch", "case", "goto", "break", "continue"}

IDENT = r"[A-Za-z_]\w*"


def read_text(path):
    with open(path, "r", encoding="utf-8", errors="surrogateescape") as f:
        return f.read()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def strip_code(text):
    """Return (cleaned, comment_line_numbers).

    Comments and string/char literals are replaced by spaces so that offsets
    and line numbers are preserved, while code-search regexes cannot match
    inside a comment or a string.
    """
    out = []
    comments = set()
    i = 0
    n = len(text)
    line = 1
    state = "code"
    while i < n:
        c = text[i]
        nxt = text[i + 1] if i + 1 < n else ""
        if state == "code":
            if c == "/" and nxt == "/":
                comments.add(line)
                out.append("  ")
                i += 2
                state = "line-comment"
                continue
            if c == "/" and nxt == "*":
                comments.add(line)
                out.append("  ")
                i += 2
                state = "block-comment"
                continue
            if c == '"':
                out.append(" ")
                i += 1
                state = "string"
                continue
            if c == "'":
                out.append(" ")
                i += 1
                state = "char"
                continue
            if c == "\n":
                line += 1
            out.append(c)
            i += 1
            continue
        if state == "line-comment":
            if c == "\n":
                out.append("\n")
                line += 1
                state = "code"
            else:
                out.append(" ")
            i += 1
            continue
        if state == "block-comment":
            if c == "*" and nxt == "/":
                out.append("  ")
                i += 2
                state = "code"
                continue
            if c == "\n":
                out.append("\n")
                line += 1
            else:
                out.append(" ")
            i += 1
            continue
        # string or char literal
        if c == "\\" and i + 1 < n:
            out.append("  ")
            i += 2
            continue
        if (state == "string" and c == '"') or (state == "char" and c == "'"):
            out.append(" ")
            i += 1
            state = "code"
            continue
        if c == "\n":
            out.append("\n")
            line += 1
            i += 1
            state = "code"
            continue
        out.append(" ")
        i += 1
    return "".join(out), comments


DECL_PREFIX_RE = re.compile(
    r"^(?P<indent>[ \t]*)"
    r"(?P<type>(?:[A-Za-z_]\w*)(?:[ \t]+[A-Za-z_]\w*)*)"
    r"[ \t]*\*[ \t]*")

DECLARATOR_RE = re.compile(
    r"^(?:\*[ \t]*)*(?P<name>" + IDENT + r")"
    r"[ \t]*=[ \t]*(?P<init>.*)$")

LABEL_RE = re.compile(r"^[ \t]*(?P<name>" + IDENT + r")[ \t]*:")

HEADER_RE = re.compile(
    r"^(?P<head>.*?(?P<name>[A-Za-z_]\w*)[ \t]*\([^;{}]*\))[ \t]*\{?[ \t]*$")


def call_name(expr):
    m = re.match(r"[ \t]*(" + IDENT + r")[ \t]*\(", expr)
    return m.group(1) if m else None


def split_top_level(text, separator=","):
    """Split text at separator characters outside (), [], {} and literals.

    A comma inside a call argument list or a compound initializer therefore
    never ends a declarator.  The caller normally passes code whose comments
    and literals are already blanked, but literals are still skipped here so
    the splitter is safe on raw source as well.
    """
    parts = []
    cur = []
    depth = 0
    quote = None
    i = 0
    while i < len(text):
        ch = text[i]
        if quote is not None:
            cur.append(ch)
            if ch == "\\" and i + 1 < len(text):
                cur.append(text[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in ("'", '"'):
            quote = ch
            cur.append(ch)
            i += 1
            continue
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            if depth > 0:
                depth -= 1
        if ch == separator and depth == 0:
            parts.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    parts.append("".join(cur))
    return parts


def parse_pointer_declaration(line):
    """Parse one single-line pointer declaration.

    Returns None when the line does not declare a pointer.  Otherwise the
    result has an indent, a type, the declarators list and an optional
    problem.  Declarators are split with split_top_level, so the initializer
    of one declarator can never absorb the comma that separates the next one.
    A declaration with more than one declarator is reported by the caller as
    multiple declarators instead of being migrated.
    """
    m = DECL_PREFIX_RE.match(line)
    if not m:
        return None
    rest = line[m.end():].rstrip()
    if not rest.endswith(";"):
        return None
    parts = split_top_level(rest[:-1])
    declarators = []
    for part in parts:
        dm = DECLARATOR_RE.match(part.strip())
        if dm:
            declarators.append((dm.group("name"), dm.group("init").strip()))
        else:
            declarators.append((None, None))
    return {
        "indent": m.group("indent"),
        "type": m.group("type"),
        "declarators": declarators,
        "problem": "multiple declarators" if len(parts) > 1 else None,
    }


def single_call_name(expr):
    """Return the callee when expr is exactly one call expression."""
    if not expr:
        return None
    m = re.match(r"[ \t]*(" + IDENT + r")[ \t]*\(", expr)
    if not m:
        return None
    depth = 0
    i = m.end() - 1
    while i < len(expr):
        ch = expr[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                if expr[i + 1:].strip():
                    return None
                return m.group(1)
        i += 1
    return None


def find_functions(clines):
    """Return a list of (header_line, body_first_line, body_last_line, name,
    params_text) 0-based, for top-level function definitions."""
    funcs = []
    n = len(clines)
    # depth before each line
    depth = 0
    depth_before = []
    for line in clines:
        depth_before.append(depth)
        depth += line.count("{") - line.count("}")
    i = 0
    while i < n:
        line = clines[i]
        s = line.strip()
        header = None
        open_line = None
        if s.endswith("{"):
            if "(" in s and ")" in s and not s.startswith(
                    ("if", "for", "while", "switch", "else", "do")):
                header = s[:-1].strip()
                open_line = i
        elif s.endswith(")") and "(" in s:
            j = i + 1
            while j < n and not clines[j].strip():
                j += 1
            if j < n and clines[j].strip() == "{":
                header = s
                open_line = j
        if header is None or open_line is None or depth_before[open_line] != 0:
            i += 1
            continue
        if "=" in header:
            i += 1
            continue
        m = re.match(r"^(?P<name>[A-Za-z_]\w*)[ \t]*\((?:[^;{}]*)\)$",
                     header)
        if m:
            name = m.group("name")
        else:
            hm = re.search(r"(?P<name>" + IDENT + r")[ \t]*\(", header)
            if not hm:
                i += 1
                continue
            name = hm.group("name")
        if name in SKIP_WORDS:
            i += 1
            continue
        pm = re.search(r"\((.*)\)[ \t]*$", header, re.S)
        params = pm.group(1) if pm else ""
        # find the matching close brace
        end = open_line
        d = 0
        while end < n:
            d += clines[end].count("{") - clines[end].count("}")
            if d == 0 and "}" in clines[end]:
                break
            end += 1
        if end >= n:
            i += 1
            continue
        funcs.append((i, open_line, end, name, params))
        i = end + 1
    return funcs


def enclosing_call(line, pos):
    """Return the callee identifier whose '(' ... ')' contains pos, or None."""
    stack = []
    for idx, ch in enumerate(line):
        if ch == "(":
            m = re.search(r"(" + IDENT + r")[ \t]*$", line[:idx])
            stack.append(m.group(1) if m else None)
        elif ch == ")" and stack:
            callee = stack.pop()
            if idx >= pos:
                return callee, True
    return (stack[-1] if stack else None), False


_CONTROL_TOKEN_RE = re.compile(
    r"[A-Za-z_]\w*|\d[\w.]*|==|!=|<=|>=|->|\+\+|--|&&|\|\||<<|>>|\S")
_IDENT_RE = re.compile(r"^" + IDENT + r"$")
_EXIT_CALLS = frozenset(("exit", "_exit", "abort", "quick_exit", "longjmp"))
_EXIT_RE = re.compile(
    r"\b(return|goto|break|continue)\b"
    r"|\b(exit|_exit|abort|quick_exit|longjmp)[ \t]*\(")


def tokenize_lines(clines, first, last):
    """Return (token, 0-based line) pairs with literals already blanked."""
    tokens = []
    for ln in range(first, last + 1):
        for m in _CONTROL_TOKEN_RE.finditer(clines[ln]):
            tokens.append((m.group(0), ln))
    return tokens


_GNU_SPELLING = {
    "__asm": "asm", "__asm__": "asm",
    "__attribute": "attribute", "__attribute__": "attribute",
    "__const": "const", "__const__": "const",
    "__inline": "inline", "__inline__": "inline",
    "__restrict": "restrict", "__restrict__": "restrict",
    "__signed": "signed", "__signed__": "signed",
    "__typeof": "typeof", "__typeof__": "typeof",
    "__volatile": "volatile", "__volatile__": "volatile",
    "__extension__": None,
}


def normalise_tokens(tokens):
    """Canonicalise GNU alternate keyword spellings, then drop no-ops."""
    out = []
    for text, line in tokens:
        text = _GNU_SPELLING.get(text, text)
        if text is None:
            continue
        out.append((text, line))
    return out


_MARKER_RE = re.compile(
    r'^#[ \t]*(?:line[ \t]+)?(\d+)[ \t]+"((?:[^"\\]|\\.)*)"')


def preprocess_source(path, cpp="cc", cpp_args=()):
    """Preprocess one translation unit and map its tokens back to its lines.

    Returns {"ok": bool, "error": str or None, "clines": list or None}.  The
    preprocessed text is rebuilt line by line for this file only: every
    non-marker output line is attributed to the source line named by the last
    #line marker, so callers can compare a function body token for token with
    the original source.
    """
    real = os.path.realpath(path)
    command = [cpp, "-E", "-x", "c"] + list(cpp_args) + [real]
    try:
        proc = subprocess.run(
            command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=120, universal_newlines=True, errors="surrogateescape")
    except OSError as exc:
        return {"ok": False, "clines": None,
                "error": "%s could not be run: %s" % (cpp, exc)}
    except subprocess.SubprocessError as exc:
        return {"ok": False, "clines": None,
                "error": "%s did not finish: %s" % (cpp, exc)}
    if proc.returncode != 0:
        diagnostic = (proc.stderr.strip().splitlines() or ["no diagnostic"])[0]
        return {"ok": False, "clines": None,
                "error": "the preprocessor failed: %s" % diagnostic}
    per_line = {}
    current_file = None
    current_line = 0
    for raw in proc.stdout.split("\n"):
        marker = _MARKER_RE.match(raw)
        if marker:
            current_line = int(marker.group(1))
            current_file = os.path.realpath(marker.group(2))
            continue
        if current_file == real:
            per_line[current_line] = per_line.get(current_line, "") + " " + raw
            current_line += 1
    if not per_line:
        return {"ok": False, "clines": None,
                "error": "the preprocessor produced no lines for this file"}
    last = max(per_line)
    source_lines = len(read_text(real).split("\n"))
    if last > source_lines:
        return {"ok": False, "clines": None,
                "error": "a macro expanded across source lines; the "
                         "preprocessed body cannot be mapped back"}
    joined = "\n".join(per_line.get(n, "") for n in range(1, last + 1))
    cleaned, _ = strip_code(joined)
    return {"ok": True, "error": None, "clines": cleaned.split("\n")}


def _control_token_texts(line):
    """Raw C token texts of one source line."""
    return [m.group(0) for m in _CONTROL_TOKEN_RE.finditer(line)]


def _tokens_texts(line):
    """Normalised token texts of one source line."""
    tokens = [(text, 0) for text in _control_token_texts(line)]
    return [text for text, _line in normalise_tokens(tokens)]


def _decl_prefix_texts(line):
    """Normalised tokens of a declaration prefix, up to its top-level '='."""
    depth = 0
    prefix = []
    for text in _control_token_texts(line):
        if text == "=" and depth == 0:
            break
        if text in "([{":
            depth += 1
        elif text in ")]}":
            depth = max(0, depth - 1)
        prefix.append(text)
    return [t for t, _line in normalise_tokens([(t, 0) for t in prefix])]


def _exit_kinds(clines, first, last):
    """Ordered control-flow exit tokens of a line range.

    Comparing the source and preprocessed sequences shows whether a macro
    introduced or removed a return, goto, break, continue or exit call.
    """
    tokens = tokenize_lines(clines, first, last)
    kinds = []
    for pos, (text, _line) in enumerate(tokens):
        if text in ("return", "goto", "break", "continue"):
            kinds.append(text)
        elif text in _EXIT_CALLS and pos + 1 < len(tokens) \
                and tokens[pos + 1][0] == "(":
            kinds.append(text)
    return kinds


def _source_release_lines(clines, first, last, name, release_fn):
    """Lines whose text names release_fn (name)."""
    pattern = re.compile(r"\b" + re.escape(release_fn) + r"\s*\(\s*"
                         + re.escape(name) + r"\s*\)")
    return [k for k in range(first, last + 1) if pattern.search(clines[k])]


def _is_name_operand(tokens, name):
    texts = [text for text, _line in _strip_outer_parens(tokens)]
    return texts == [name]


def _is_null_operand(tokens):
    """True for 0, NULL, and the common (void *)0 spelling of NULL."""
    texts = [text for text, _line in _strip_outer_parens(tokens)]
    if texts in (["0"], ["NULL"]):
        return True
    return texts == ["(", "void", "*", ")", "0"]


def _strip_outer_parens(tokens):
    tokens = list(tokens)
    while len(tokens) >= 2 and tokens[0][0] == "(" and tokens[-1][0] == ")":
        depth = 0
        closes_at_end = False
        for pos, (text, _line) in enumerate(tokens):
            if text == "(":
                depth += 1
            elif text == ")":
                depth -= 1
                if depth == 0:
                    closes_at_end = pos == len(tokens) - 1
                    break
        if not closes_at_end:
            break
        tokens = tokens[1:-1]
    return tokens


def _is_null_test(tokens, name):
    """True when the condition is exactly !p, p == NULL or NULL == p."""
    tokens = _strip_outer_parens(tokens)
    texts = [text for text, _line in tokens]
    if texts == ["!", name]:
        return True
    depth = 0
    for pos, (text, _line) in enumerate(tokens):
        if text in "([{":
            depth += 1
        elif text in ")]}":
            depth -= 1
        elif text == "==" and depth == 0:
            left = tokens[:pos]
            right = tokens[pos + 1:]
            if _is_name_operand(left, name) and _is_null_operand(right):
                return True
            return _is_null_operand(left) and _is_name_operand(right, name)
    return False


class _ControlScanner:
    """Lexical, conservative statement scanner for one function body.

    It parses just enough C to decide whether one token starts an
    unconditional top-level statement of the function body.  Control
    statements consume their body statement, so a release inside an unbraced
    if/else/for/while/switch body, in a labelled statement or in a nested
    block is recognised as conditional even when a label or a multi-line
    condition sits between the keyword and the release.
    """

    def __init__(self, tokens, target):
        self.tokens = tokens
        self.i = 0
        self.target = target
        self.found = None
        self.ifs = []
        self.starts = []

    def _peek(self, offset=0):
        pos = self.i + offset
        if pos >= len(self.tokens):
            raise _ControlScanError("unexpected end of the function body")
        return self.tokens[pos]

    def _take(self):
        if self.target is not None and self.i == self.target:
            # The release token is not at a statement boundary; it is part
            # of a larger expression or statement.
            raise _ControlScanStop()
        token = self._peek()
        self.i += 1
        return token

    def _line(self):
        return self.tokens[self.i - 1][1] if self.i else self.tokens[0][1]

    def _take_balanced(self, opener, closer):
        if self._peek()[0] != opener:
            raise _ControlScanError("expected %r" % opener)
        self._take()
        inner = []
        depth = 1
        while True:
            token, line = self._take()
            if token == opener:
                depth += 1
            elif token == closer:
                depth -= 1
                if depth == 0:
                    return inner
            inner.append((token, line))

    def _check_target(self, level, context):
        self.starts.append((self.i, (level, tuple(context))))
        if self.target is not None and self.i == self.target:
            self.found = (level, tuple(context))
            raise _ControlScanStop()

    def run(self):
        while True:
            token, _line = self._take()
            if token == "{":
                break
        try:
            self._compound(0, ())
        except _ControlScanStop:
            pass

    def _compound(self, level, context):
        terminal = None
        while True:
            if self._peek()[0] == "}":
                self._take()
                return terminal
            terminal = self._statement(level, context)

    def _statement(self, level, context):
        while True:
            token, line = self._peek()
            nxt = self._peek(1)[0]
            if token in ("case", "default"):
                self._take()
                depth = 0
                while True:
                    item, _ln = self._take()
                    if item in "([{":
                        depth += 1
                    elif item in ")]}":
                        depth -= 1
                    elif item == ":" and depth == 0:
                        break
                context = context + ("a switch case",)
                continue
            if _IDENT_RE.match(token) and nxt == ":":
                self._take()
                self._take()
                continue
            break
        self._check_target(level, context)
        pos = self.i
        token, line = self._peek()
        if token == "{":
            self._take()
            terminal = self._compound(level + 1, context + ("a nested block",))
            return {"kind": "block", "start_line": line,
                    "end_line": self._line(), "terminal": terminal}
        if token == "if":
            self._take()
            cond = self._take_balanced("(", ")")
            then = self._statement(level + 1, context + ("the body of an if",))
            has_else = False
            else_stmt = None
            if self._peek()[0] == "else":
                self._take()
                has_else = True
                else_stmt = self._statement(
                    level + 1, context + ("the body of an else",))
            info = {
                "level": level,
                "start_line": line,
                "cond": cond,
                "then": then,
                "has_else": has_else,
                "else": else_stmt,
            }
            self.ifs.append(info)
            return {"kind": "if", "start_line": line,
                    "end_line": self._line(), "terminal": None}
        if token in ("for", "while", "switch"):
            kind = token
            self._take()
            self._take_balanced("(", ")")
            self._statement(level + 1, context + ("the body of a %s" % kind,))
            return {"kind": kind, "start_line": line,
                    "end_line": self._line(), "terminal": None}
        if token == "do":
            self._take()
            self._statement(level + 1, context + ("the body of a do",))
            if self._peek()[0] != "while":
                raise _ControlScanError("expected while after do body")
            self._take()
            self._take_balanced("(", ")")
            if self._peek()[0] != ";":
                raise _ControlScanError("expected ; after do-while")
            self._take()
            return {"kind": "do", "start_line": line,
                    "end_line": self._line(), "terminal": None}
        if token == ";":
            self._take()
            return {"kind": "empty", "start_line": line,
                    "end_line": line, "terminal": None}
        if token == "}":
            raise _ControlScanError("unexpected }")
        return self._simple(line, pos)

    def _simple(self, line, pos):
        first = self._peek()[0]
        terminal = None
        if first == "return":
            terminal = {"kind": "return", "line": line, "pos": pos}
        elif first == "goto":
            self._take()
            target, _ln = self._take()
            terminal = {"kind": "goto", "line": line, "pos": pos,
                        "target": target}
        elif first in ("break", "continue"):
            terminal = {"kind": first, "line": line, "pos": pos}
        elif first in _EXIT_CALLS and self._peek(1)[0] == "(":
            terminal = {"kind": "abort" if first == "abort" else "exit",
                        "line": line, "pos": pos}
        self._skip_to_semicolon()
        return {"kind": "simple", "start_line": line,
                "end_line": self._line(), "terminal": terminal}

    def _skip_to_semicolon(self):
        depth = {"(": 0, "[": 0, "{": 0}
        pairs = {")": "(", "]": "[", "}": "{"}
        while True:
            token, _line = self._take()
            if token in depth:
                depth[token] += 1
            elif token in pairs:
                opener = pairs[token]
                if depth[opener] == 0:
                    raise _ControlScanError(
                        "a statement ended before its semicolon")
                depth[opener] -= 1
            elif token == ";" and not any(depth.values()):
                return


def release_control_context(clines, start, end, release_line, release_fn):
    """Classify the release call at release_line.

    Returns (top_level, description, ifs).  top_level is True only when the
    release call begins a statement directly in the function body compound
    statement.  Everything from the opening brace to the release line is
    inspected, so labels, multi-line conditions, switch cases and brace-less
    control statements cannot hide a conditional path.
    """
    for k in range(start, release_line + 1):
        if clines[k].lstrip().startswith("#"):
            return False, "a preprocessor directive inside the function body", []
    tokens = tokenize_lines(clines, start, end)
    target = None
    for pos, (token, line) in enumerate(tokens):
        if line == release_line and token == release_fn:
            target = pos
            break
    if target is None:
        return False, "the release call is not in the token stream", []
    scanner = _ControlScanner(tokens, target)
    try:
        scanner.run()
    except _ControlScanError:
        return False, "the control context could not be lexically analysed", []
    if scanner.found is None:
        return False, "the release is not a statement boundary", scanner.ifs
    level, context = scanner.found
    if level != 0:
        description = "; ".join(context) or "a nested statement"
        return False, description, scanner.ifs
    return True, None, scanner.ifs


def function_label_lines(clines, start, end):
    """Map each ordinary label in a function body to its 0-based line."""
    labels = {}
    for k in range(start, end + 1):
        m = LABEL_RE.match(clines[k])
        if m and m.group("name") not in ("case", "default"):
            labels.setdefault(m.group("name"), k)
    return labels


def label_line_between(clines, first, last):
    """Return the 0-based line of an ordinary label in [first, last]."""
    for k in range(first, last + 1):
        m = LABEL_RE.match(clines[k])
        if m and m.group("name") not in ("case", "default"):
            return k
    return None


def _terminal_of(stmt):
    """Return the terminal dict of a parsed statement, unwrapping blocks."""
    while stmt is not None and "start_line" in stmt:
        stmt = stmt.get("terminal")
    return stmt


def guard_covers_exit(ifs, labels, exit_line, name, release_line,
                      exit_pos=None):
    """True when a top-level null guard's then branch ends at this exit.

    exit_pos, when given, is the token index of the exit that must be the
    guard's terminal statement, so two exits on one physical line cannot
    borrow each other's guard.
    """
    for info in ifs:
        if info["level"] != 0 or info["has_else"]:
            continue
        if not _is_null_test(info["cond"], name):
            continue
        terminal = _terminal_of(info["then"])
        if terminal is None or terminal["line"] != exit_line:
            continue
        if exit_pos is not None and terminal.get("pos") != exit_pos:
            continue
        kind = terminal["kind"]
        if kind not in ("return", "exit", "abort", "goto"):
            continue
        if kind == "goto":
            target_line = labels.get(terminal.get("target"))
            if target_line is None or target_line <= release_line:
                continue
        return True
    return False


class _FunctionFacts:
    """Per-function caches shared by every candidate of that function."""

    def __init__(self, clines, start, end):
        self.start = start
        self.end = end
        self.tokens = tokenize_lines(clines, start, end)
        scanner = _ControlScanner(self.tokens, None)
        self.scan_ok = True
        try:
            scanner.run()
        except _ControlScanError:
            self.scan_ok = False
        self.ifs = scanner.ifs
        self.starts = dict(scanner.starts)
        self.labels = function_label_lines(clines, start, end)
        self.label_lines = sorted(self.labels.values())
        self.directive_lines = [k for k in range(start, end + 1)
                                if clines[k].lstrip().startswith("#")]
        self.body_depth = {}
        depth = 0
        for k in range(start, end + 1):
            depth += clines[k].count("{") - clines[k].count("}")
            self.body_depth[k] = depth
        self.func_depth = self.body_depth[start]
        self.exits = []
        self.occ = {}
        for pos, (token, line) in enumerate(self.tokens):
            if token in ("return", "goto", "break", "continue"):
                self.exits.append((pos, line))
            elif token in _EXIT_CALLS and pos + 1 < len(self.tokens) \
                    and self.tokens[pos + 1][0] == "(":
                self.exits.append((pos, line))
            if _IDENT_RE.match(token):
                self.occ.setdefault(token, []).append((pos, line))

    def release_position(self, release_line, release_fn):
        for pos, (token, line) in enumerate(self.tokens):
            if line == release_line and token == release_fn:
                return pos
        return None

    def identifier_lines(self, name):
        return sorted({line for _pos, line in self.occ.get(name, [])})

    def first_label_between(self, first, last):
        k = bisect.bisect_left(self.label_lines, first)
        if k < len(self.label_lines) and self.label_lines[k] <= last:
            return self.label_lines[k]
        return None

    def first_occurrence_line_after(self, name, line):
        for _pos, ln in self.occ.get(name, []):
            if ln > line:
                return ln
        return None


def load_sidecars(root):
    """Parse every .crugffi under root.  Returns (owned_return, consumes).

    owned_return maps a function to its destructor (or None);
    consumes maps a function to the set of consumed argument indices.
    """
    owned = {}
    consumes = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
        for fn in sorted(filenames):
            if not fn.endswith(".crugffi"):
                continue
            path = os.path.join(dirpath, fn)
            text = read_text(path)
            text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
            lines = [l.split("#", 1)[0] for l in text.splitlines()]
            header_ok = False
            for line in lines:
                first = line.strip()
                if not first:
                    continue
                head = re.match(r"crugffi[ \t]+(\d+)\.(\d+)[ \t]*;", first)
                header_ok = head is not None and int(head.group(1)) == 1
                break
            if not header_ok:
                print("c2crug: ignoring sidecar %s: the first line is not a "
                      "'crugffi 1.<minor>;' header" %
                      os.path.relpath(path, root), file=sys.stderr)
                continue
            current = None
            clauses = []
            for line in lines:
                s = line.strip()
                if not s or s.startswith("crugffi"):
                    continue
                m = re.match(r"fn[ \t]+(" + IDENT + r")", s)
                if m:
                    current = m.group(1)
                    clauses = []
                    consumed = set()
                    consumes[current] = consumed
                    rest = s[m.end():]
                    if rest.strip():
                        clauses.append(rest.strip())
                    continue
                if current is not None:
                    clauses.append(s)
            for name, parts in list(consumes.items()):
                body = " ".join(clauses_for(text, name))
                for clause in body.split(";"):
                    toks = clause.split()
                    if not toks:
                        continue
                    if toks[0] == "returns" and "owned" in toks:
                        drop = None
                        if "drop" in toks:
                            k = toks.index("drop")
                            if k + 1 < len(toks):
                                drop = toks[k + 1]
                        owned[name] = drop
                    elif toks[0] == "consumes":
                        for t in toks[1:]:
                            if t.startswith("arg") and t[3:].isdigit():
                                consumes[name].add(int(t[3:]))
    return owned, consumes


def clauses_for(text, name):
    """Return the clause text that follows 'fn name' up to the next fn."""
    out = []
    active = False
    for line in text.splitlines():
        s = line.split("#", 1)[0].strip()
        if not s or s.startswith("crugffi"):
            continue
        m = re.match(r"fn[ \t]+(" + IDENT + r")", s)
        if m:
            active = (m.group(1) == name)
            rest = s[m.end():].strip()
            if active and rest:
                out.append(rest)
            continue
        if active:
            out.append(s)
    return out


def split_params(params):
    out = []
    depth = 0
    cur = ""
    for ch in params:
        if ch in "([":
            depth += 1
        if ch in ")]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return out


def analyse_source(path, rel, owned_return, consumes, preproc=None):
    """Return (entries, transformed_text or None).

    A pointer is migrated only when its origin and its single release are
    both structurally proven; everything ambiguous becomes a raw entry.  When
    preproc is the result of preprocess_source(), the proof itself runs on the
    preprocessed text, so a macro can neither hide an exit nor invent a
    release.  A function is eligible for rewriting only when the declaration
    prefix and the release call it rewrites are spelled identically in the
    source and after preprocessing, and preprocessing introduces or removes
    no control-flow exit token; otherwise it is reported ineligible.
    """
    text = read_text(path)
    cleaned, _ = strip_code(text)
    lines = text.split("\n")
    clines = cleaned.split("\n")
    entries = []
    if preproc is None:
        preproc = preprocess_source(path)
    preproc_ok = bool(preproc.get("ok"))
    pp_clines = preproc.get("clines") if preproc_ok else None
    if pp_clines is not None and len(pp_clines) < len(clines):
        pp_clines = pp_clines + [""] * (len(clines) - len(pp_clines))
    pp_view = pp_clines if preproc_ok else clines
    unusable = preproc.get("error")
    state = {"eligibility": "eligible" if preproc_ok else "ineligible"}

    def add(kind, lineno, col, confidence, reason, applied, extra=None):
        entry = {
            "file": rel,
            "line": lineno,
            "column": col,
            "kind": kind,
            "applied": applied,
            "confidence": round(confidence, 2),
            "reason": reason,
            "evidence": {
                "file": rel,
                "line": lineno,
                "text": lines[lineno - 1].rstrip() if lineno - 1 < len(lines) else "",
            },
            "preprocessed": preproc_ok,
            "eligibility": state["eligibility"],
        }
        if extra:
            entry.update(extra)
        entries.append(entry)

    def add_ineligible(lineno, col, reason):
        previous = state["eligibility"]
        state["eligibility"] = "ineligible"
        add("raw", lineno, col, 0.0, reason, False)
        state["eligibility"] = previous

    release_fns = set([HEAP_RELEASE])
    release_fns.update(d for d in owned_return.values() if d)
    release_fns.update(consumes.keys())
    non_retaining = set(NON_RETAINING)
    funcs = find_functions(clines)

    for (hdr, start, end, fname, params) in funcs:
        source_directive = any(
            clines[k].lstrip().startswith("#") for k in range(start, end + 1))
        if not preproc_ok:
            body_eligible = False
            inelig_reason = ("the function body could not be preprocessed (%s)"
                             % unusable)
        elif source_directive:
            body_eligible = False
            inelig_reason = "a preprocessor directive inside the function body"
        elif _exit_kinds(clines, start, end) != _exit_kinds(pp_clines, start,
                                                            end):
            body_eligible = False
            inelig_reason = "macro expansion inside the function body"
        else:
            body_eligible = True
            inelig_reason = None
        state["eligibility"] = "eligible" if body_eligible else "ineligible"
        facts = _FunctionFacts(pp_view, start, end)
        func_depth = facts.func_depth
        body_depth = facts.body_depth
        for i in range(start + 1, end):
            parsed = parse_pointer_declaration(clines[i])
            if parsed is None:
                continue
            indent = parsed["indent"]
            decl_type = parsed["type"]
            declarators = parsed["declarators"]
            if re.search(r"\b(own|raw|ref|mut)\b", decl_type):
                continue
            if parsed["problem"]:
                if any(init and single_call_name(init)
                       for _declname, init in declarators):
                    add("raw", i + 1, len(indent) + 1, 0.0,
                        "multiple declarators are not migrated (the "
                        "declaration introduces %d declarators)"
                        % len(declarators), False)
                continue
            if len(declarators) != 1 or declarators[0][0] is None:
                continue
            name, init = declarators[0]
            parsed_pp = parse_pointer_declaration(pp_view[i])
            if parsed_pp is None or parsed_pp["problem"] \
                    or len(parsed_pp["declarators"]) != 1 \
                    or parsed_pp["declarators"][0][0] != name:
                add_ineligible(i + 1, len(indent) + 1,
                               "macro expansion inside the function body")
                continue
            init_fn = single_call_name(parsed_pp["declarators"][0][1])
            if init_fn is None:
                if single_call_name(init) is not None:
                    add_ineligible(i + 1, len(indent) + 1,
                                   "macro expansion inside the function body")
                continue
            if init_fn in HEAP_FNS:
                release_fn = HEAP_RELEASE
                source = "the allocation catalogue"
            elif init_fn in owned_return:
                release_fn = owned_return[init_fn]
                source = "the .crugffi contract for %s" % init_fn
            else:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "unknown ownership origin: %s is neither an allocation "
                    "function nor declared owned by a sidecar" % init_fn,
                    False)
                continue
            if release_fn is None:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "the sidecar declares %s as owned but names no destructor"
                    % init_fn, False)
                continue
            if not body_eligible:
                add("raw", i + 1, len(indent) + 1, 0.0, inelig_reason, False)
                continue
            src_release = set(_source_release_lines(clines, i + 1, end, name,
                                                    release_fn))
            pp_release = set(_source_release_lines(pp_clines, i + 1, end, name,
                                                   release_fn))
            spans_ok = (_decl_prefix_texts(clines[i])
                        == _decl_prefix_texts(pp_clines[i]))
            if spans_ok:
                for k in src_release:
                    if _tokens_texts(clines[k]) != _tokens_texts(pp_clines[k]):
                        spans_ok = False
                        break
            if not spans_ok or src_release != pp_release:
                add_ineligible(i + 1, len(indent) + 1,
                               "macro expansion inside the function body")
                continue
            problem = None
            problem_line = None
            release_lines = []
            for k in facts.identifier_lines(name):
                if k <= i or k >= end:
                    continue
                line = pp_clines[k]
                for mo in re.finditer(r"\b" + re.escape(name) + r"\b", line):
                    pos = mo.start()
                    before = line[:pos]
                    after = line[pos + len(name):]
                    if re.search(r"&\s*$", before):
                        problem = "the address of the pointer is taken"
                        problem_line = k
                        break
                    if re.match(r"[ \t]*=(?!=)", after):
                        problem = "the pointer is reassigned"
                        problem_line = k
                        break
                    if re.search(r"(\+\+|--)[ \t]*$", before) or \
                            re.match(r"[ \t]*(\+\+|--)", after) or \
                            re.match(r"[ \t]*[-+] ", after):
                        problem = "the pointer is adjusted arithmetically"
                        problem_line = k
                        break
                    if re.search(r"\breturn\b[^;{}]*$", before):
                        problem = "the pointer is returned"
                        problem_line = k
                        break
                    if re.search(r"(?<![=!<>+\-*/%&|^])"
                                 r"=[^=;]*$", before) and \
                            re.match(r"[ \t]*[,;)]", after):
                        problem = "the pointer is copied into another variable"
                        problem_line = k
                        break
                    if re.match(r"[ \t]*(\[|->|\.)", after):
                        continue
                    call, inside = enclosing_call(line, pos)
                    if inside and call:
                        if call == release_fn:
                            release_lines.append(k)
                        elif call not in non_retaining and \
                                call not in SKIP_WORDS:
                            problem = ("the pointer escapes into function %s "
                                       "at line %d" % (call, k + 1))
                            problem_line = k
                            break
                if problem:
                    break
            if problem:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "%s (line %d)" % (problem, problem_line + 1), False)
                continue
            if not release_lines:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "no %s of the pointer was found" % release_fn, False)
                continue
            if len(set(release_lines)) > 1:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "the pointer is released more than once", False)
                continue
            rel_line = release_lines[0]
            rel_pos = facts.release_position(rel_line, release_fn)
            if rel_pos is None:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "the release call is not in the token stream", False)
                continue
            stmt_re = re.compile(r"^[ \t]*" + re.escape(release_fn)
                                 + r"[ \t]*\(\s*" + re.escape(name)
                                 + r"\s*\)[ \t]*;[ \t]*$")
            if not stmt_re.match(clines[rel_line]):
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "the release is not a standalone statement on every path",
                    False)
                continue
            if body_depth[i] != func_depth:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "the declaration is not a top-level statement at "
                    "function depth", False)
                continue
            if not facts.scan_ok:
                top_level = False
                context = "the control context could not be lexically analysed"
            elif rel_pos not in facts.starts:
                top_level = False
                context = "the release is not a statement boundary"
            else:
                level, inner = facts.starts[rel_pos]
                top_level = level == 0
                context = "; ".join(inner) or "a nested statement"
            label_line = facts.first_label_between(i + 1, rel_line)
            if not top_level:
                reason = ("the release at line %d is on a conditional path "
                          "(%s)" % (rel_line + 1, context))
                if label_line is not None:
                    reason += ("; a label or goto target lies between the "
                               "declaration and the release (line %d)"
                               % (label_line + 1))
                add("raw", i + 1, len(indent) + 1, 0.0, reason, False)
                continue
            if label_line is not None:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "a label or goto target lies between the declaration "
                    "and the release (line %d)" % (label_line + 1), False)
                continue
            exit_bad = None
            guarded = False
            for pos, line in facts.exits:
                if line <= i or pos >= rel_pos:
                    continue
                if guard_covers_exit(facts.ifs, facts.labels, line, name,
                                     rel_line, pos):
                    guarded = True
                    continue
                exit_bad = line
                break
            if exit_bad is not None:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "an early exit at line %d can skip the release"
                    % (exit_bad + 1), False)
                continue
            used_after = facts.first_occurrence_line_after(name, rel_line)
            if used_after is not None:
                add("raw", i + 1, len(indent) + 1, 0.0,
                    "the pointer is used after its release (line %d)"
                    % (used_after + 1), False)
                continue
            lines[i] = indent + "own " + lines[i][len(indent):]
            lines[rel_line] = re.sub(r"\b" + re.escape(release_fn) + r"\b",
                                     "drop", lines[rel_line], count=1)
            confidence = 0.80 if guarded else 1.0
            if guarded:
                reason = ("single %s from %s released once by %s after a "
                          "proven null guard" % (init_fn, source, release_fn))
            else:
                reason = ("single %s from %s released once by %s on a "
                          "straight-line path"
                          % (init_fn, source, release_fn))
            add("own", i + 1, len(indent) + 1, confidence, reason, True,
                {"transformation": {
                    "declaration_line": i + 1,
                    "release_line": rel_line + 1,
                    "release_from": release_fn,
                    "release_to": "drop",
                }})

        if not body_eligible:
            continue
        body = "\n".join(clines[start + 1:end])
        for param in split_params(params):
            pm = re.match(r"(?P<type>.*?)\*(?P<pname>" + IDENT +
                          r")\s*(?:\[[^\]]*\])?\s*$", param.strip())
            if not pm:
                continue
            pname = pm.group("pname")
            type_tokens = pm.group("type").split()
            if any(w in type_tokens for w in
                   ("own", "ref", "mut", "raw", "restrict")):
                continue
            writes = re.search(r"\*\s*" + re.escape(pname) + r"\b\s*=|"
                               + re.escape(pname) + r"\s*->\s*\w+\s*=|"
                               + re.escape(pname) + r"\s*\[[^\]]*\]\s*=",
                               body)
            escapes = (re.search(r"\bfree\s*\(\s*" + re.escape(pname) + r"\s*\)",
                                 body)
                       or re.search(r"\breturn\b[^;]*\b" + re.escape(pname)
                                    + r"\b", body))
            if escapes:
                continue
            suggestion = "mut" if writes else "ref"
            add("borrow-suggestion", hdr + 1, len(pm.group("type")) + 1,
                0.60 if writes else 0.80,
                "parameter %s is %s inside %s; a %s parameter would state that "
                "(suggestion only)" % (pname,
                                       "written" if writes else "never written",
                                       fname, suggestion),
                False, {"suggestion": suggestion})

    state["eligibility"] = "eligible" if preproc_ok else "ineligible"

    # global declarations are never rewritten
    in_function = [False] * len(clines)
    for (_hdr, start, end, _fname, _params) in funcs:
        for k in range(start + 1, end):
            in_function[k] = True
    for i, line in enumerate(clines):
        parsed = parse_pointer_declaration(line)
        if parsed is None:
            continue
        if in_function[i]:
            continue
        init_fns = [single_call_name(init)
                    for _declname, init in parsed["declarators"] if init]
        if any(fn in HEAP_FNS or fn in owned_return for fn in init_fns):
            add("raw", i + 1, len(parsed["indent"]) + 1, 0.0,
                "file-scope storage is not migrated by Phase 12", False)

    transformed = "\n".join(lines) if any(e["kind"] == "own" for e in entries) \
        else None
    return entries, transformed

def build_report(mode, entries, sources):
    return {
        "schema": SCHEMA_ID,
        "tool": "c2crug",
        "version": VERSION,
        "mode": mode,
        "sources": sources,
        "entries": entries,
        "counts": {
            "own": sum(1 for e in entries if e["kind"] == "own"),
            "raw": sum(1 for e in entries if e["kind"] == "raw"),
            "borrow_suggestion": sum(
                1 for e in entries if e["kind"] == "borrow-suggestion"),
            "applied": sum(1 for e in entries if e["applied"]),
        },
    }


def walk_sources(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames
                             if not d.startswith(".")
                             and d not in ("build", "out"))
        for fn in sorted(filenames):
            if fn.endswith(".c"):
                path = os.path.join(dirpath, fn)
                rel = os.path.relpath(path, root)
                yield path, rel


def print_entry(entry):
    print("%s:%d:%d: %s confidence=%.2f %s%s" % (
        entry["file"], entry["line"], entry["column"], entry["kind"],
        entry["confidence"], entry["reason"],
        "" if entry["applied"] else " [not applied]"))


def validate_report(report):
    errors = []
    if report.get("schema") != SCHEMA_ID:
        errors.append("schema id is not %s" % SCHEMA_ID)
    if report.get("tool") != "c2crug":
        errors.append("tool is not c2crug")
    for key in ("mode", "sources", "entries", "counts"):
        if key not in report:
            errors.append("missing key %s" % key)
    for e in report.get("entries", []):
        for key in ("file", "line", "column", "kind", "applied",
                    "confidence", "reason", "evidence"):
            if key not in e:
                errors.append("entry missing %s: %r" % (key, e))
                continue
        if e["kind"] not in ("own", "raw", "borrow-suggestion"):
            errors.append("unknown entry kind %r" % e["kind"])
        if e["applied"] and e["kind"] != "own":
            errors.append("only an own entry may be applied: %r" % e)
        if e["applied"]:
            if not (0 < e["confidence"] <= 1):
                errors.append("applied entry needs confidence in (0,1]")
            ev = e["evidence"]
            if not (ev.get("file") and ev.get("line") and ev.get("text")):
                errors.append("applied entry needs a full evidence location")
        if e["kind"] == "raw" and e["applied"]:
            errors.append("a raw entry may not be applied")
        if "preprocessed" not in e:
            errors.append("entry missing preprocessed: %r" % e)
        elif not isinstance(e["preprocessed"], bool):
            errors.append("preprocessed must be a boolean: %r" % e)
        if e.get("eligibility") not in ("eligible", "ineligible"):
            errors.append("unknown eligibility %r in %r"
                          % (e.get("eligibility"), e))
        elif e["eligibility"] == "ineligible":
            if e["applied"]:
                errors.append("an ineligible entry may not be applied: %r" % e)
            if e["confidence"] != 0:
                errors.append("an ineligible entry needs confidence 0: %r"
                              % e)
    own = sum(1 for e in report.get("entries", []) if e["kind"] == "own")
    raw = sum(1 for e in report.get("entries", []) if e["kind"] == "raw")
    counts = report.get("counts", {})
    if counts.get("own") != own or counts.get("raw") != raw:
        errors.append("counts do not match the entry list")
    return errors


def cmd_analyze(root, report_path, cpp="cc", cpp_args=None):
    owned_return, consumes = load_sidecars(root)
    entries = []
    sources = []
    for path, rel in walk_sources(root):
        sources.append({"file": rel, "sha256": sha256_file(path)})
        preproc = preprocess_source(path, cpp, cpp_args or ())
        found, _ = analyse_source(path, rel, owned_return, consumes, preproc)
        entries.extend(found)
    entries.sort(key=lambda e: (e["file"], e["line"], e["column"]))
    # --analyze changes nothing: the report is a plan, so nothing is applied.
    planned = []
    for e in entries:
        copy = dict(e)
        copy["applied"] = False
        planned.append(copy)
    for e in planned:
        print_entry(e)
    report = build_report("analyze", planned, sources)
    errors = validate_report(report)
    if errors:
        for err in errors:
            print("c2crug: report error: %s" % err, file=sys.stderr)
        return 1
    if report_path:
        write_json(report_path, report)
    print("c2crug: %d file(s), %d own, %d raw, %d borrow suggestion(s)"
          % (len(sources), report["counts"]["own"], report["counts"]["raw"],
             report["counts"]["borrow_suggestion"]))
    return 0


def cmd_safe(root, out, report_path, diff_only, cpp="cc", cpp_args=None):
    if not diff_only:
        if os.path.exists(out):
            print("c2crug: output directory already exists: %s" % out,
                  file=sys.stderr)
            return 2
        shutil.copytree(root, out)
    owned_return, consumes = load_sidecars(root)
    entries = []
    sources = []
    diffs = []
    for path, rel in walk_sources(root):
        sources.append({"file": rel, "sha256": sha256_file(path)})
        preproc = preprocess_source(path, cpp, cpp_args or ())
        found, transformed = analyse_source(path, rel, owned_return, consumes,
                                            preproc)
        entries.extend(found)
        if transformed is not None:
            if diff_only:
                import difflib
                old = read_text(path).split("\n")
                new = transformed.split("\n")
                diffs.extend(difflib.unified_diff(
                    old, new, fromfile=os.path.join(root, rel),
                    tofile=os.path.join(out, rel), lineterm=""))
            else:
                with open(os.path.join(out, rel), "w", encoding="utf-8",
                          errors="surrogateescape") as f:
                    f.write(transformed)
    entries.sort(key=lambda e: (e["file"], e["line"], e["column"]))
    if diff_only:
        print("\n".join(diffs))
        if not diffs:
            print("c2crug: no proven transformation; nothing to do")
        return 0
    for e in entries:
        print_entry(e)
    report = build_report("safe", entries, sources)
    errors = validate_report(report)
    if errors:
        for err in errors:
            print("c2crug: report error: %s" % err, file=sys.stderr)
        return 1
    if report_path:
        write_json(report_path, report)
    print("c2crug: %d file(s), %d own, %d raw, %d borrow suggestion(s)"
          % (len(sources), report["counts"]["own"], report["counts"]["raw"],
             report["counts"]["borrow_suggestion"]))
    return 0


def write_json(path, report):
    parent = os.path.dirname(os.path.abspath(path))
    if parent and not os.path.isdir(parent):
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, sort_keys=False)
        f.write("\n")


def main(argv):
    ap = argparse.ArgumentParser(
        prog="c2crug",
        description="conservative C to Crug migration assistant")
    mode = ap.add_mutually_exclusive_group(required=False)
    mode.add_argument("--analyze", action="store_true",
                      help="report candidates without changing anything")
    mode.add_argument("--safe", action="store_true",
                      help="copy the tree and apply proven transformations")
    mode.add_argument("--diff", action="store_true",
                      help="print the diff that --safe would apply")
    ap.add_argument("root", nargs="?")
    ap.add_argument("-o", "--output", default=None)
    ap.add_argument("--report", default=None)
    ap.add_argument("--cpp", default="cc", metavar="PATH",
                    help="preprocessor used to detect macro expansion "
                         "(default: cc)")
    ap.add_argument("--cpp-arg", action="append", default=None,
                    metavar="ARG", dest="cpp_args",
                    help="extra argument for the preprocessor (repeatable)")
    ap.add_argument("--version", action="store_true")
    args = ap.parse_args(argv)
    if args.version:
        print("c2crug %s" % VERSION)
        return 0
    if not (args.analyze or args.safe or args.diff):
        ap.error("one of the arguments --analyze --safe --diff is required")
    if args.root is None:
        ap.error("a source tree argument is required unless --version is used")
    root = args.root
    if not os.path.isdir(root):
        print("c2crug: not a directory: %s" % root, file=sys.stderr)
        return 2
    if args.analyze:
        return cmd_analyze(root, args.report, args.cpp, args.cpp_args)
    if args.diff:
        out = args.output or (root.rstrip("/") + "-crug")
        return cmd_safe(root, out, args.report, True,
                        args.cpp, args.cpp_args)
    out = args.output
    if not out:
        print("c2crug: --safe needs -o OUT", file=sys.stderr)
        return 2
    return cmd_safe(root, out, args.report, False, args.cpp, args.cpp_args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
