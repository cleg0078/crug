#!/bin/sh
# crugc - the CRUG driver.
#
# Phase 1 is plain C compatibility: crugc must behave exactly like the GCC it
# is built from, with no changed defaults, include paths or specs. This launcher
# therefore execs the in-tree GCC driver with -B pointing at its own directory,
# which is how an uninstalled GCC finds cc1, as and the target libraries.
#
# Two behaviours are its own:
#   --version prints the Crug release version together with the compiler,
#   language, Crug ABI, runtime ABI, FFI and PAL versions, each on its own line
#   (RFC-0001 section 8.2).  Everything else, including -dumpversion and -v,
#   is the GCC driver's answer.
#
# Resolution order:
#   1. CRUGC_REAL_DRIVER, if set (tests use it to pin a driver).
#   2. build/obj/gcc/xgcc of this checkout, for an out-of-tree build.
#   3. xgcc next to this script, for an in-tree build.
#   4. gcc next to this script, for an installed tree (only when the same
#      prefix also carries libexec/gcc or lib/gcc, so a symlink such as
#      /usr/bin/crugc cannot silently select the host compiler).
# Anything else is an error: silently falling back to the host gcc would
# compare the wrong compilers and hide driver drift.
set -eu

crug_version=0.2.1
crug_language=0.1.0
crug_abi=1
crug_runtime_abi=1
crug_ffi=1.0
crug_pal=1.2

# Follow symlinks: an installed /usr/bin/crugc is a link to
# <prefix>/bin/crugc and must find <prefix>, not /usr.
self=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f -- "$self" 2>/dev/null) || resolved=
  if [ -n "${resolved:-}" ]; then
    self=$resolved
  fi
fi
here=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

# The version file sits at the top of a checkout and beside the documentation
# of an installed tree.
if [ -f "$root/VERSION" ]; then
  crug_version=$(cat "$root/VERSION")
elif [ -f "$root/share/doc/crug/VERSION" ]; then
  crug_version=$(cat "$root/share/doc/crug/VERSION")
fi

driver_b=
if [ -n "${CRUGC_REAL_DRIVER:-}" ]; then
  if [ ! -x "$CRUGC_REAL_DRIVER" ]; then
    echo "crugc: CRUGC_REAL_DRIVER is not executable: $CRUGC_REAL_DRIVER" >&2
    exit 1
  fi
  driver=$CRUGC_REAL_DRIVER
else
  driver=
  for candidate in "$root/build/obj/gcc/xgcc" "$here/xgcc"; do
    if [ -x "$candidate" ]; then
      driver=$candidate
      driver_b=-B"$(dirname -- "$candidate")/"
      break
    fi
  done
  if [ -z "$driver" ] && [ -x "$here/gcc" ]; then
    if [ -d "$root/libexec/gcc" ] || [ -d "$root/lib/gcc" ] ||
       [ -d "$root/lib64/gcc" ]; then
      driver=$here/gcc
    fi
  fi
  if [ -z "$driver" ]; then
    echo "crugc: no Crug GCC driver found" >&2
    echo "crugc: looked for $root/build/obj/gcc/xgcc, $here/xgcc and the" >&2
    echo "crugc: driver of an install tree at $here/gcc" >&2
    echo "crugc: build one with 'make baseline' or set CRUGC_REAL_DRIVER" >&2
    exit 1
  fi
fi

exec_driver () {
  if [ -n "$driver_b" ]; then
    exec "$driver" "$driver_b" "$@"
  fi
  exec "$driver" "$@"
}

case "${1-}" in
  --version)
    gcc_version=$("$driver" -dumpfullversion 2>/dev/null || echo unknown)
    printf 'crugc %s\n' "$crug_version"
    printf 'compiler: GCC %s\n' "$gcc_version"
    printf 'language version: %s\n' "$crug_language"
    printf 'Crug ABI version: %s\n' "$crug_abi"
    printf 'runtime ABI version: %s\n' "$crug_runtime_abi"
    printf 'FFI metadata version: %s\n' "$crug_ffi"
    printf 'PAL version: %s\n' "$crug_pal"
    exit 0
    ;;
esac

exec_driver "$@"
