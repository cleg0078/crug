#
# GCC testsuite for Crug grammar fixes: the contextual-qualifier scan reads
# up to eight tokens ahead instead of four, and a longer chain is an ordinary
# syntax error without parser state corruption (P3-008, ADR 0029 D10).

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cSi\]]] \
	"" $DEFAULT_CFLAGS

dg-finish
