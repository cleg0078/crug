#
# GCC testsuite for the Crug channels and 'select' statement: typed channel
# construction, send, receive, close, the ownership rules of an owning
# element, and the four select arm forms.  Every test carries its own
# dg-options, so DEFAULT_CFLAGS stays empty.  The runtime behaviour is
# exercised by libcrug/tests/channels and scripts/check-channels.sh.

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cSi\]]] \
	"" $DEFAULT_CFLAGS

dg-finish
