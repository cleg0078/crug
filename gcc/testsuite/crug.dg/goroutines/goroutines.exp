#
# GCC testsuite for the Crug goroutine and task statements: 'go f (args);',
# 'go (call);' and 'yield ();'.  Every test carries its own dg-options, so
# DEFAULT_CFLAGS stays empty.  These tests only compile: the runtime is
# linked and run by scripts/check-goroutines.sh and libcrug/tests.

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cSi\]]] \
	"" $DEFAULT_CFLAGS

dg-finish
