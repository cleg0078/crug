#
# GCC testsuite for the Crug front end.  Each test carries its own
# dg-options, so DEFAULT_CFLAGS stays empty: the -ansi -pedantic-errors
# of gcc.dg would not describe the Crug dialect.

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/ownership/*.\[cSi\]]] \
	"" $DEFAULT_CFLAGS

dg-finish
