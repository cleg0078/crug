#
# GCC testsuite for the Crug 'scope' statement: the task group that waits for
# every child of its block.  Every test carries its own dg-options, so
# DEFAULT_CFLAGS stays empty.  The runtime behaviour is exercised by
# libcrug/tests/scope and scripts/check-scope.sh.

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cSi\]]] \
	"" $DEFAULT_CFLAGS

dg-finish
