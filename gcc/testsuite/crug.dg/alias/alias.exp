#
# GCC testsuite for -fcrug-alias-facts: the optimizer fact that a mut or own
# parameter is an exclusive borrow.  Each test carries its own dg-options, so
# DEFAULT_CFLAGS stays empty.

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if ![info exists DEFAULT_CFLAGS] then {
    set DEFAULT_CFLAGS ""
}

dg-init

dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cSi\]]] \
	"" $DEFAULT_CFLAGS

dg-finish
