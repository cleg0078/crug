# The Send/Sync checks of ADR 0026 are compile-time only: every case here
# is a dg-do compile with its own -fcrug-* flags.  The runtime side (a task
# really receiving a copied value) lives in libcrug/tests/goroutines and
# scripts/check-send-sync.sh.

load_lib gcc-dg.exp

# The default flags of this directory are none; each test names its flags.
set DEFAULT_CFLAGS ""

dg-init
dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.\[cSi\]]] "" $DEFAULT_CFLAGS
dg-finish
