  set -e; for ml in `/src/build/obj/./gcc/xgcc -B/src/build/obj/./gcc/  -print-multi-lib`; do \
    multi_dir=`echo ${ml} | sed -e 's/;.*$//'`; \
    flags=`echo ${ml} | sed -e 's/^[^;]*;//' -e 's/@/ -/g'`; \
    if [ x != x ]; then \
      if [ ! -f  ]; then \
	echo "fixinc_list: Failed to find "; \
	exit 1; \
      fi; \
      set +e; \
      found=`grep "^${multi_dir}$" `; \
      set -e; \
      if [ -z "$found" ]; then \
	continue; \
      fi; \
    fi; \
    sfx=`/src/build/obj/./gcc/xgcc -B/src/build/obj/./gcc/  ${flags} -print-sysroot-headers-suffix`; \
    if [ "${multi_dir}" = "." ]; \
      then multi_dir=""; \
    else \
      multi_dir=/${multi_dir}; \
    fi; \
    echo "${sfx};${multi_dir}"; \
  done; \
else \
  echo ";"; \
fi > tmp-fixinc_list
